{
  "schema_version": 1,
  "mihomo": {
    "dns": {
      "respect-rules": true,
      "prefer-h3": false,
      "default-nameserver": [
        "tls://223.5.5.5:853"
      ],
      "proxy-server-nameserver": [
        "https://223.5.5.5/dns-query#DIRECT"
      ],
      "nameserver": [
        "https://1.1.1.1/dns-query#PROXY"
      ],
      "nameserver-policy": {
        "rule-set:private": [
          "rcode://refused"
        ],
        "rule-set:lan-com": [
          "https://223.5.5.5/dns-query#DIRECT"
        ]
      },
      "direct-nameserver": [
        "https://223.5.5.5/dns-query#DIRECT"
      ],
      "direct-nameserver-follow-policy": true
    }
  },
  "surge": {
    "general": {
      "encrypted-dns-server": "https://1.1.1.1/dns-query,https://8.8.8.8/dns-query",
      "encrypted-dns-follow-outbound-mode": "true",
      "hijack-dns": "*:53"
    },
    "rules_prepend": [
      "PROTOCOL,STUN,PROXY",
      "PROTOCOL,DOH,PROXY",
      "PROTOCOL,DOH3,PROXY",
      "PROTOCOL,DOQ,PROXY",
      "PROTOCOL,DOT,PROXY"
    ]
  }
}
