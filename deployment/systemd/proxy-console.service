[Unit]
Description=SSH-only private configuration console
After=sub-store.service
Requires=sub-store.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/proxy-distribution/console.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/x-ui
ReadWritePaths=/var/lib/proxy-distribution
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
